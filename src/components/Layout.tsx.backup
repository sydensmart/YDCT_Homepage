import React, { useState, useEffect } from "react";
import { NavLink, Link, useLocation } from "react-router-dom";
import { Menu, X, Globe, ChevronDown, Mail, Phone, MapPin, Building2 } from "lucide-react";
import { SiLinkedin, SiYoutube, SiGithub } from "react-icons/si";
import { motion, AnimatePresence } from "framer-motion";
import { cn, ROUTE_PATHS } from "@/lib/index";
import { Button } from "@/components/ui/button";
import { useLanguage } from "@/contexts/LanguageContext";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";

interface NavItem {
  label: string;
  path: string;
}

const NAV_ITEMS: NavItem[] = [
  { label: "회사소개", path: ROUTE_PATHS.ABOUT },
  { label: "사업영역", path: ROUTE_PATHS.BUSINESS },
  { label: "인사이트", path: ROUTE_PATHS.INSIGHTS },
  { label: "고객지원", path: ROUTE_PATHS.CONTACT },
];

const NAV_ITEMS_EN: NavItem[] = [
  { label: "About", path: ROUTE_PATHS.ABOUT },
  { label: "Business", path: ROUTE_PATHS.BUSINESS },
  { label: "Insights", path: ROUTE_PATHS.INSIGHTS },
  { label: "Contact", path: ROUTE_PATHS.CONTACT },
];

export function Layout({ children }: { children: React.ReactNode }) {
  const [isScrolled, setIsScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const { pathname } = useLocation();
  const { language, setLanguage, t } = useLanguage();

  const navItems = language === "en" ? NAV_ITEMS_EN : NAV_ITEMS;

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 20);
    };
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  useEffect(() => {
    setIsMobileMenuOpen(false);
    window.scrollTo(0, 0);
  }, [pathname]);

  return (
    <div className="relative min-h-screen flex flex-col">
      {/* Header */}
      <header
        className={cn(
          "fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b",
          isScrolled
            ? "bg-background/80 backdrop-blur-md border-border py-3"
            : "bg-transparent border-transparent py-5"
        )}
      >
        <div className="container mx-auto px-4 flex items-center justify-between">
          <LinavItemsUTE_PATHS.HOME} className="flex items-center gap-2">
            <img 
              src="/images/ydct-logo.png" 
              alt="YDCT Logo" 
              className="h-[4.5rem] w-auto object-contain"
            />
          </Link>

          {/* Desktop Navigation */}
          <nav className="hidden md:flex items-center space-x-8">
            {NAV_ITEMS.map((item) => (
              <NavLink
                key={item.path}
                to={item.path}
                className={({ isActive }) =>
                  cn(
                    "text-sm font-medium transition-colors hover:text-primary",
                    isActive ? "text-primary" : "text-muted-foreground"
                  )
                }
              >
                {item.label}
              </NavLink>
            ))}
          </nav>

          {/* Desktop Right Actions */}
          <div className="hidden md:flex items-center space-x-4">
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button variant="ghost" size="sm" className="flex items-center gap-1">
                  <Globe className="w-4 h-4" />
                  <span className="text-sm font-medium">{language === "en" ? "EN" : "KR"}</span>
                  <ChevronDown className="w-3 h-3 opacity-50" />
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end">
                <DropdownMenuItem 
                  className="cursor-pointer"
                  onClick={() => setLanguage("ko")}
                >
                  한국어 (KR)
                </DropdownMenuItem>
                <DropdownMenuItem 
                  className="cursor-pointer"
                  onClick={() => setLanguage("en")}
                >
                  English (EN)
                </DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
            <Button asChild variant="default" size="sm" className="rounded-full px-6">
              <Link to={ROUTE_PATHS.CONTACT + "#contact-form"}>
                {t("문의하기", "Contact")}
              </Link>
            </Button>
          </div>

          {/* Mobile Menu Toggle */}
          <button
            className="md:hidden p-2 text-foreground"
            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
            aria-label="Toggle menu"
          >
            {isMobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
          </button>
        </div>
      </header>navItems

      {/* Mobile Menu Overlay */}
      <AnimatePresence>
        {isMobileMenuOpen && (
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -20 }}
            className="fixed inset-0 z-40 bg-background pt-24 px-6 md:hidden"
          >
            <nav className="flex flex-col space-y-6">
              {NAV_ITEMS.map((item) => (
                <NavLink
                    {t("문의하기", "Contact")}
                  </Link>
                </Button>
                <div className="flex items-center justify-center space-x-4 pt-4">
                  <span className="text-sm text-muted-foreground">Language:</span>
                  <button 
                    className={cn(
                      "text-sm transition-colors",
                      language === "ko" ? "font-bold text-primary" : "text-muted-foreground"
                    )}
                    onClick={() => setLanguage("ko")}
                  >
                    KR
                  </button>
                  <span className="text-muted-foreground">|</span>
                  <button 
                    className={cn(
                      "text-sm transition-colors",
                      language === "en" ? "font-bold text-primary" : "text-muted-foreground"
                    )}
                    onClick={() => setLanguage("en")}
                  >
                    EN
                  
              {t("개인정보처리방침", "Privacy Policy")}
            </Link>
            <Link to={ROUTE_PATHS.SITEMAP} className="text-sm text-muted-foreground hover:text-primary transition-colors font-medium">
              {t("사이트맵", "Sitemap")}
            </Link>
          </div>

          {/* 중단: 기업 정보 */}
          <div className="mb-8 space-y-3">
            <div className="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 text-sm text-muted-foreground">
              <div className="flex items-center gap-2">
                <span className="font-medium text-foreground">{t("대표자명:", "CEO:")}</span>
                <span>{t("서영득", "Young-Deuk Seo")}</span>
              </div>
              <div className="flex items-center gap-2">
                <span className="font-medium text-foreground">{t("사업자등록번호:", "Business No:")}</span>
                <span>508-61-20118</span>
              </div>
            </div>
            <div className="flex items-start gap-2 text-sm text-muted-foreground">
              <MapPin className="w-4 h-4 text-primary shrink-0 mt-0.5" />
              <span>
                {language === "en" 
                  ? "402, 45-10 Seongan-ro 13-gil, Gangdong-gu, Seoul, South Korea"
                  : "서울시 강동구 성안로 13길 45-10, 402호"
                }
              
      </main>

      {/* Footer */}
      <footer className="bg-muted/30 border-t border-border">
        <div className="container mx-auto px-4 py-12">
          {/* 상단: 개인정보처리방침, 사이트맵 */}
          <div className="flex flex-wrap justify-center md:justify-start gap-6 mb-8 pb-8 border-b border-border/50">
            <Link to={ROUTE_PATHS.PRIVACY} className="text-sm text-muted-foreground hover:text-primary transition-colors font-medium">
              개인정보처리방침
            </Link>
            <Link to={ROUTE_PATHS.SITEMAP} className="text-sm text-muted-foreground hover:text-primary transition-colors font-medium">
              사이트맵
            </Link>
          </div>

          {/* 중단: 기업 정보 */}
          <div className="mb-8 space-y-3">
            <div className="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 text-sm text-muted-foreground">
              <div className="flex items-center gap-2">
                <span className="font-medium text-foreground">대표자명:</span>
                <span>서영득</span>
              </div>
              <div className="flex items-center gap-2">
                <span className="font-medium text-foreground">사업자등록번호:</span>
                <span>508-61-20118</span>
              </div>
            </div>
            <div className="flex items-start gap-2 text-sm text-muted-foreground">
              <MapPin className="w-4 h-4 text-primary shrink-0 mt-0.5" />
              <span>서울시 강동구 성안로 13길 45-10, 402호</span>
            </div>
            <div className="flex items-center gap-2 text-sm text-muted-foreground">
              <Mail className="w-4 h-4 text-primary shrink-0" />
              <a href="mailto:ydct2025@gmail.com" className="hover:text-primary transition-colors">
                ydct2025@gmail.com
              </a>
            </div>
          </div>

          {/* 하단: 소셜 미디어 & Copyright */}
          <div className="pt-6 border-t border-border/50 flex flex-col md:flex-row items-center justify-between gap-6">
            <p className="text-xs text-muted-foreground">
              &copy; 2026 YDCT. All rights reserved.
            </p>
            <div className="flex items-center gap-4">
              <a 
                href="https://www.youtube.com/@YDCTbiz" 
                target="_blank" 
                rel="noopener noreferrer"
                className="text-muted-foreground hover:text-primary transition-colors"
                aria-label="YouTube"
              >
                <SiYoutube className="w-5 h-5" />
              </a>
              <a 
                href="https://github.com/sydensmart" 
                target="_blank" 
                rel="noopener noreferrer"
                className="text-muted-foreground hover:text-primary transition-colors"
                aria-label="GitHub"
              >
                <SiGithub className="w-5 h-5" />
              </a>
              <a 
                href="https://www.linkedin.com/in/%EC%98%81%EB%93%9D-%EC%84%9C-391b058a/" 
                target="_blank" 
                rel="noopener noreferrer"
                className="text-muted-foreground hover:text-primary transition-colors"
                aria-label="LinkedIn"
              >
                <SiLinkedin className="w-5 h-5" />
              </a>
              <a 
                href="https://profile.rememberapp.co.kr/" 
                target="_blank" 
                rel="noopener noreferrer"
                className="text-xs font-medium text-muted-foreground hover:text-primary transition-colors px-2 py-1 border border-border rounded"
                aria-label="Remember Profile"
              >
                Remember
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}
